# Generated per-scene build artifacts (regenerate with build.py)
/output/*
!/output/elven_arena/
/output/elven_arena/*
!/output/elven_arena/README_Godot.md
!/output/island_arena/
/output/island_arena/*
!/output/island_arena/README_Godot.md
!/output/star_arena/
/output/star_arena/*
!/output/star_arena/README_Godot.md
!/output/cel_forest_arena/
/output/cel_forest_arena/*
!/output/cel_forest_arena/README_Godot.md
/checkpoints/
/textures/
/renders/*
!/renders/island_arena/
/renders/island_arena/*
!/renders/island_arena/hero.png
!/renders/island_arena/godot_sunny.png
!/renders/island_arena/godot_storm.png
!/renders/island_arena/godot_night.png
!/renders/elven_arena/
/renders/elven_arena/*
!/renders/elven_arena/hero.png
!/renders/star_arena/
/renders/star_arena/*
!/renders/star_arena/hero.png
!/renders/cel_forest_arena/
/renders/cel_forest_arena/*
!/renders/cel_forest_arena/hero.png
!/renders/cel_forest_arena/godot_hero.png

# Godot import cache (regenerated on first open)
/godot/.godot/
/godot/*/.godot/

# Blender / Python
*.blend1
*.log
__pycache__/
*.pyc

# Harness-local settings
.claude/
/vibe_images/
